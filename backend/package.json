{
  "name": "Finime",
  "version": "1.2.0",
  "type": "module",
  "module": "dist/index.js",
  "types": "dist/index.js",
  "main": "dist/index.js",
  "scripts": {
    "build:bun": "bun build --compile --minify-whitespace --minify-syntax --target bun --outfile ./dist/index.js ./src/index.ts",
    "build": "prisma generate && rimraf dist && tsc && tsc-alias",
    "build:prisma": "tsc && prisma generate",
    "dev": "bun run --watch src/index.ts",
    "clean": "bun scripts/clean.js",
    "deploy": "wrangler deploy --minify src/index.ts",
    "start": "node dist/index.js",
    "vercel-build": "npm run build"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.3.3",
    "@elysiajs/node": "^1.3.0",
    "@prisma/client": "^6.10.1",
    "@zanixongroup/uploader": "^2.1.1",
    "axios": "^1.10.0",
    "bcrypt": "^6.0.0",
    "cheerio": "1.0.0-rc.12",
    "dotenv": "^17.0.1",
    "elysia": "^1.3.5",
    "elysia-cache": "^0.1.0",
    "form-data": "^4.0.4",
    "lru-cache": "^11.1.0",
    "module-alias": "^2.2.3",
    "nodemailer": "^7.0.3",
    "string-comparison": "^1.3.0",
    "web-push": "^3.6.7",
    "wrangler": "^4.23.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^24.0.10",
    "@types/nodemailer": "^6.4.17",
    "@types/web-push": "^3.6.4",
    "bun-types": "latest",
    "prisma": "^6.10.1",
    "rimraf": "^6.0.1",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}